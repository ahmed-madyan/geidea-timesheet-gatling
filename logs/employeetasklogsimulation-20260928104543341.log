    <script>
        // Live clock
        function updateDateTime() {
            const now = new Date();
            const el = document.getElementById('live-clock');
            if (el) {
                el.innerText = now.toLocaleDateString('en-GB', {
                    weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
                }) + '  •  ' + now.toLocaleTimeString();
            }
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>

    <script>
        function initProjectTruncation() {
            document.querySelectorAll('.ts-project-name-truncate').forEach(function (el) {
                if (el.dataset.initialized) return;
                el.dataset.initialized = 'true';

                // Check if the element overflows horizontally
                if (el.scrollWidth > el.offsetWidth) {
                    var toggle = document.createElement('a');
                    toggle.href = '#';
                    toggle.className = 'toggle-text-btn ms-1';
                    toggle.textContent = 'More';

                    toggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        if (el.classList.contains('expanded')) {
                            el.classList.remove('expanded');
                            toggle.textContent = 'More';
                        } else {
                            el.classList.add('expanded');
                            toggle.textContent = 'Less';
                        }
                    });

                    el.after(toggle);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Tiny timeout to ensure client layout computations have completed
            setTimeout(initProjectTruncation, 50);
        });
    </script>

    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    // Adapter for [DateGreaterThanOrEqualTo] — current date input must be >= the referenced date input.
    // Emits data-val-dategreaterthanequalto and data-val-dategreaterthanequalto-other on the client.
    (function ($) {
        if (!$.validator || !$.validator.unobtrusive) return;

        $.validator.addMethod("dategreaterthanequalto", function (value, element, params) {
            if (!value) return true; // let [Required] handle empty values
            var $other = $(element).closest("form").find('input[name="' + params.otherName + '"]');
            if ($other.length === 0) return true;
            var otherValue = $other.val();
            if (!otherValue) return true; // let [Required] on the other field handle empty values

            var current = new Date(value);
            var other = new Date(otherValue);
            if (isNaN(current.getTime()) || isNaN(other.getTime())) return true;

            return current.getTime() >= other.getTime();
        });

        $.validator.unobtrusive.adapters.add("dategreaterthanequalto", ["other"], function (options) {
            // Derive the other input's name from the validated element's name by swapping
            // the last path segment, e.g. "Query.Filter.EndDate" -> "Query.Filter.StartDate",
            // "Input.EndDate" -> "Input.StartDate". This is independent of element ids (which
            // may be overridden) and is scoped to the same form to avoid matching hidden
            // round-trip inputs in other forms on the same page.
            var elementName = options.element.name;
            var lastDot = elementName.lastIndexOf(".");
            var otherName = lastDot >= 0
                ? elementName.substring(0, lastDot + 1) + options.params.other
                : options.params.other;

            options.rules["dategreaterthanequalto"] = { otherName: otherName };
            if (options.message) {
                options.messages["dategreaterthanequalto"] = options.message;
            }

            // Re-run this field's validation when the referenced field changes,
            // so the comparison error stays accurate as the user edits either date.
            var $form = $(options.element).closest("form");
            $form.find('input[name="' + otherName + '"]').on("change input", function () {
                var validator = $form.data("validator");
                if (validator) validator.element(options.element);
            });
        });
    })(jQuery);

    $(document).ready(function () {
        $("form").validate({
            rules: {
                "Input.ProjectName": {
                    required: true,
                    maxlength: 200
                },
                "Input.ProjectDetails": {
                    required: true,
                    maxlength: 16384
                }
            },
            messages: {
                "Input.ProjectName": {
                    maxlength: "Project Name cannot exceed 200 characters."
                },
                "Input.ProjectDetails": {
                    maxlength: "Project Details cannot exceed 16,384 characters."
                }
            },
            errorElement: 'span',
            errorClass: 'text-danger small',
            highlight: function (element) {
                $(element).addClass('input-validation-error');
            },
            unhighlight: function (element) {
                $(element).removeClass('input-validation-error');
            }
        });
    });
</script>

    <script>
        const projectSelect = new TomSelect('#ddlProject', {
            placeholder: '-- Select Project --',
            searchField: ['text'],
            maxOptions: null,
            shouldLoad: q => q.length >= 3,
            onChange(val) {
                const pnl = document.getElementById('pnlProjContext');
                if (!val) { pnl.style.display = 'none'; triggerValidate(); return; }
                fetch(`?handler=ProjectDetails&projectId=${encodeURIComponent(val)}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data && data[0]) {
                            document.getElementById('litProjCountry').innerText  = data[0].country    || '-';
                            document.getElementById('litProjCategory').innerText = data[0].category   || '-';
                            document.getElementById('litProjDept').innerText     = data[0].department || '-';
                            pnl.style.display = 'grid';
                        } else {
                            pnl.style.display = 'none';
                        }
                    })
                    .catch(() => pnl.style.display = 'none')
                    .finally(() => triggerValidate());
            }
        });

        // expose so filter IIFE can call it
        function triggerValidate() {
            document.getElementById('ddlProject').dispatchEvent(new Event('change'));
        }

        // placeholder — real handler is TomSelect onChange above
        document.getElementById('ddlProject').addEventListener('change', function() {
            const val = this.value;
            const pnl = document.getElementById('pnlProjContext');

            if (!val) {
                pnl.style.display = 'none';
                return;
            }

        // handled by TomSelect onChange
        });

        (function () {
        const form = document.querySelector('form');
        const btn = document.getElementById('btnSubmit');

        const requiredIds = [
            'ddlProject', // TomSelect updates the underlying <select> value
            'Input_TaskName',
            'Input_Description',
            'Input_TaskDate',
            'Input_Hours'
        ];

        function validate() {
            const allFilled = requiredIds.every(id => {
                const el = document.getElementById(id);
                return el && el.value.trim() !== '' && el.value !== '0';
            });
            btn.disabled = !allFilled;
        }

        requiredIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', validate);
        });

        validate(); // run once on load



        btn.addEventListener('click', function() {
            setTimeout(() => {
                btn.disabled = true; // prevent multiple submits
            }, 100);
        });

    })();


    (function () {
    const ddlDept    = document.getElementById('ddlDepartment');
    const ddlCountry = document.getElementById('ddlCountry');
    const ddlProject = document.getElementById('ddlProject');
    const spinner    = document.getElementById('projLoadSpinner');
    const badge      = document.getElementById('filterBadge');
    const badgeText  = document.getElementById('filterBadgeText');
    const clearBtn   = document.getElementById('clearFilters');
    const pnl        = document.getElementById('pnlProjContext');

    // Initialize TomSelect with server-provided projects on page load
    const initialProjects = Array.from(ddlProject.options)
        .filter(opt => opt.value !== '')
        .map(opt => ({ value: opt.value, text: opt.text }));

    if (initialProjects.length > 0) {
        projectSelect.addOptions(initialProjects);
    }

    function updateBadge() {
        const parts = [];
        if (ddlDept.value)    parts.push(ddlDept.options[ddlDept.selectedIndex].text);
        if (ddlCountry.value) parts.push(ddlCountry.options[ddlCountry.selectedIndex].text);
        if (parts.length) {
            badgeText.textContent = 'Filtered by: ' + parts.join(' · ');
            badge.style.display = 'block';
        } else {
            badge.style.display = 'none';
        }
    }

    function rebuildProjectDropdown(projects) {
        const currentVal = projectSelect.getValue();
        projectSelect.clearOptions();
        projectSelect.addOptions(projects.map(p => ({ value: p.value, text: p.text })));

        const stillValid = projects.some(p => p.value === currentVal);
        if (stillValid) {
            projectSelect.setValue(currentVal, true);
        } else {
            projectSelect.clear(true);
            pnl.style.display = 'none';
        }

        document.getElementById('ddlProject').dispatchEvent(new Event('change'));
    }

    function fetchFilteredProjects() {
        const deptId    = ddlDept.value;
        const countryId = ddlCountry.value;

        spinner.style.display = 'inline';

        fetch(`?handler=FilteredProjects&departmentId=${encodeURIComponent(deptId)}&countryId=${encodeURIComponent(countryId)}`)
            .then(r => r.json())
            .then(projects => {
                rebuildProjectDropdown(projects);
                updateBadge();
            })
            .catch(err => console.error('Filter error:', err))
            .finally(() => spinner.style.display = 'none');
    }

    ddlDept.addEventListener('change', fetchFilteredProjects);
    ddlCountry.addEventListener('change', fetchFilteredProjects);

    clearBtn?.addEventListener('click', function (e) {
        e.preventDefault();
        ddlDept.value = '';
        ddlCountry.value = '';
        fetchFilteredProjects();
    });
})();

    // Delete modal
    function showDeleteModal(logId, taskName, projectName) {
        document.getElementById('deleteLogId').value = logId;
        document.getElementById('deleteTaskName').textContent = taskName;
        document.getElementById('deleteProjectName').textContent = projectName;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
    </script>

</body>
</html>

