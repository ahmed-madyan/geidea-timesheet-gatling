<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Login — Geidea Timesheet</title>
    <link rel="icon" href="/Img/Logo-1.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #ff6a00;
            --primary-hover: #e65f00;
            --accent-blue: #007bff;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --card-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Outfit', sans-serif !important;
            margin: 0;
            overflow: hidden;
            background: #ffffff;
        }

        .login-wrapper {
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card-v2 {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border-radius: 2rem;
            box-shadow: var(--card-shadow);
            padding: 3.5rem 2.5rem;
            width: 100%;
            max-width: 480px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: transform 0.3s ease;
            animation: fadeIn 0.8s ease-out;
        }

        .login-card-v2:hover {
            transform: translateY(-5px);
        }

        .login-title-v2 {
            color: #000D47;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 0.95rem;
            margin-bottom: 2.5rem;
        }

        .input-group-custom {
            margin-bottom: 1.8rem;
            position: relative;
        }

        .input-group-custom .form-control {
            border-radius: 12px;
            padding: 0.8rem 1rem 0.8rem 2.8rem;
            border: 1px solid #e1e4e8;
            background: #f8f9fa;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .input-group-custom .form-label {
            font-weight: 600;
            color: #2d3436;
            margin-bottom: 0.6rem;
            display: block;
            font-size: 0.9rem;
        }

        .input-group-custom i {
            position: absolute;
            left: 1rem;
            top: 2.8rem;
            color: #adb5bd;
            transition: color 0.3s ease;
        }

        .input-group-custom .form-control:focus {
            background: #fff;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(255, 106, 0, 0.1);
        }

        .input-group-custom .form-control:focus + i {
            color: var(--primary-color);
        }

        .btn-login-v2 {
            background: linear-gradient(135deg, var(--primary-color) 0%, #ff8c3a 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 1rem;
            font-weight: 700;
            width: 100%;
            margin-top: 1rem;
            box-shadow: 0 10px 20px rgba(255, 106, 0, 0.2);
            transition: all 0.3s ease;
        }

        .btn-login-v2:hover {
            background: linear-gradient(135deg, #e65f00 0%, #ff6a00 100%);
            transform: translateY(-2px);
            box-shadow: 0 15px 25px rgba(255, 106, 0, 0.3);
            color: #fff;
        }

        .footer-links {
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid #f1f3f5;
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: center;
        }

        .footer-link-v2 {
            color: #495057;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .footer-link-v2:hover {
            color: var(--primary-color);
        }

        .footer-link-primary {
            color: var(--primary-color);
            font-weight: 600;
        }

        .error-message {
            color: #d63031;
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            display: block;
            margin-bottom: 1rem;
        }

        .success-message {
            color: #10b981;
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            display: block;
            margin-bottom: 1rem;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main-footer {
            position: absolute;
            bottom: 20px;
            color: #6c757d;
            font-size: 0.9rem;
            font-weight: 400;
            letter-spacing: 0.5px;
        }

        .main-footer b {
            color: var(--accent-blue);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card-v2">
            <div class="text-center">
                <h2 class="login-title-v2">Welcome Back</h2>
                <p class="login-subtitle">Please enter your credentials to access your account</p>
            </div>

            <form method="post">

                <div class="input-group-custom">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" placeholder="Jane Doe" required data-val="true" data-val-required="The Username field is required." id="Username" name="Username" value="" />
                    <i class="fas fa-user"></i>
                </div>

                <div class="input-group-custom">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" placeholder="••••••••" required data-val="true" data-val-required="The Password field is required." id="Password" name="Password" />
                    <i class="fas fa-lock"></i>
                </div>

                <button type="submit" class="btn btn-login-v2">Sign In</button>
            <input name="__RequestVerificationToken" type="hidden" value="CfDJ8BI-c4uK7X5IoIBooCv4s2VWMKMzc86Pqbh3wBxDCPpkaXjEVnq1kstf6Mn-HVSDLt_lOoIj1yi7hdF_mYKTLpErtl-qA_MzkSHczux2DRKZUdy6MvNfsp0cm9KCYND23jNaw6JI8qmFKpjoq6vg2Nc" /></form>

            <div class="footer-links">
                <a class="footer-link-v2 footer-link-primary" href="/CreatePassword">
                    <i class="fas fa-key me-2"></i>First Time? Create Password
                </a>
                <!-- <a asp-page="/CreatePassword" asp-route-type="reset" class="footer-link-v2">
                    Can't sign in? Forgot Password
                </a> -->
            </div>
        </div>

        <div class="main-footer">
            © 2026 Geidea Financial Solutions.
        </div>
    </div>
</body>
</html>

