    <script>
        // Live clock
        function updateDateTime() {
            const now = new Date();
            const el = document.getElementById('live-clock');
            if (el) {
                el.innerText = now.toLocaleDateString('en-GB', {
                    weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
                }) + '  •  ' + now.toLocaleTimeString();
            }
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>

    <script>
        function initProjectTruncation() {
            document.querySelectorAll('.ts-project-name-truncate').forEach(function (el) {
                if (el.dataset.initialized) return;
                el.dataset.initialized = 'true';

                // Check if the element overflows horizontally
                if (el.scrollWidth > el.offsetWidth) {
                    var toggle = document.createElement('a');
                    toggle.href = '#';
                    toggle.className = 'toggle-text-btn ms-1';
                    toggle.textContent = 'More';

                    toggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        if (el.classList.contains('expanded')) {
                            el.classList.remove('expanded');
                            toggle.textContent = 'More';
                        } else {
                            el.classList.add('expanded');
                            toggle.textContent = 'Less';
                        }
                    });

                    el.after(toggle);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Tiny timeout to ensure client layout computations have completed
            setTimeout(initProjectTruncation, 50);
        });
    </script>

    
    <script>
        const allowedPageSizes = [5,10,20,50,100,200];
        let currentPageIndex = 1;
        let currentPageSize = 5;
        let isRequestInFlight = false;
        let messageTimeout = null;
        let selectedLogIds = new Set();
        let pendingBulkAction = null;
        let bulkModal = null;

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function escapeHtml(value) {
            if (value == null) return '';
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatTaskDate(iso) {
            const date = new Date(iso);
            if (Number.isNaN(date.getTime())) return '';
            return date.toLocaleDateString('en-US', {
                weekday: 'long',
                month: 'short',
                day: '2-digit',
                year: 'numeric'
            });
        }

        function showMessage(text, cssClass) {
            const messageEl = document.getElementById('approval-message');
            const messageTextEl = document.getElementById('approval-message-text');
            if (!messageEl || !messageTextEl) return;

            messageEl.className = `${cssClass} mb-4 p-3 rounded is-visible`;
            messageTextEl.textContent = text;

            if (messageTimeout) clearTimeout(messageTimeout);
        }

        function setLoading(cardEl, isLoading) {
            if (!cardEl) return;
            cardEl.classList.toggle('is-loading', isLoading);
            cardEl.querySelectorAll('.btn-action').forEach(btn => {
                btn.disabled = isLoading;
            });
        }

        function renderTaskCard(task, pageIndex, pageSize) {
            const hours = Number(task.hours ?? 0).toFixed(1);
            return `
                <div class="ts-task-card" data-log-id="${task.logId}">
                    <div class="task-top">
                        <div class="task-user">
                            <input type="checkbox" class="task-select" data-log-id="${task.logId}"
                                   aria-label="Select task for ${escapeHtml(task.fullName)}" />
                            <i class="fas fa-user-circle fa-lg"></i>
                            ${escapeHtml(task.fullName)}
                        </div>
                        <div class="task-hours-badge">
                            <input type="number" value="${hours}" step="0.5" min="0.5" max="24" class="edit-hours" />
                            <span>h</span>
                        </div>
                    </div>
                    <div class="task-body">
                        <div class="task-proj">
                            <i class="fas fa-folder me-1"></i>
                            <span class="ts-project-name-truncate" title="${escapeHtml(task.projectName)}">${escapeHtml(task.projectName)}</span>
                        </div>
                        <div class="task-name">${escapeHtml(task.taskName)}</div>
                        <div class="task-desc">${escapeHtml(task.taskDescription)}</div>
                    </div>
                    <div class="task-footer">
                        <div class="task-date">
                            <i class="far fa-calendar me-1"></i>
                            ${escapeHtml(formatTaskDate(task.taskDate))}
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" data-action="approve" class="btn-action approve">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" data-action="reject" class="btn-action reject">
                                <i class="fas fa-times"></i> Reject
                            </button>
                        </div>
                    </div>
                </div>`;
        }

        function renderResultsHeader(meta) {
            const headerEl = document.getElementById('approval-results-header');
            if (!headerEl) return;

            if (!meta || meta.totalItems === 0) {
                headerEl.innerHTML = '';
                return;
            }

            const startItem = ((meta.pageIndex - 1) * meta.pageSize) + 1;
            const endItem = startItem + meta.items.length - 1;
            const sizeOptions = allowedPageSizes.map(size =>
                `<option value="${size}"${size === meta.pageSize ? ' selected' : ''}>${size}</option>`
            ).join('');

            headerEl.innerHTML = `
                <div class="results-header">
                    <div class="results-count">
                        <strong>${meta.totalItems}</strong> pending task(s) &mdash; Showing ${startItem}&ndash;${endItem}
                    </div>
                    <div class="page-size-form">
                        <label for="approvalPageSize">Rows per page</label>
                        <select id="approvalPageSize" class="ts-select page-size-select">${sizeOptions}</select>
                    </div>
                </div>
                <div class="bulk-toolbar" id="bulkToolbar">
                    <div class="bulk-toolbar-left">
                        <button type="button" id="bulkSelectAll" class="bulk-select-all">
                            <i class="fas fa-check-square"></i>
                            <span>Select All</span>
                        </button>
                        <span class="bulk-count" id="bulkCount">0 selected</span>
                    </div>
                    <div class="bulk-toolbar-right">
                        <button type="button" id="bulkApproveBtn" class="btn-bulk btn-bulk-approve" disabled>
                            <i class="fas fa-check"></i> Approve Selected
                        </button>
                        <button type="button" id="bulkRejectBtn" class="btn-bulk btn-bulk-reject" disabled>
                            <i class="fas fa-times"></i> Reject Selected
                        </button>
                    </div>
                </div>`;
        }

        function renderPagination(meta) {
            const paginationEl = document.getElementById('approval-pagination');
            if (!paginationEl) return;

            if (!meta || meta.totalPages <= 1) {
                paginationEl.innerHTML = '';
                return;
            }

            const currentPage = meta.pageIndex;
            const totalPages = meta.totalPages;
            const windowSize = 2;
            let windowStart = Math.max(1, currentPage - windowSize);
            let windowEnd = Math.min(totalPages, currentPage + windowSize);

            if (currentPage - windowSize <= 2) {
                windowEnd = Math.min(totalPages, 1 + (windowSize * 2));
            }

            if (currentPage + windowSize >= totalPages - 1) {
                windowStart = Math.max(1, totalPages - (windowSize * 2));
            }

            let html = '<nav class="ts-pagination" aria-label="Approval tasks pagination">';

            if (meta.hasPreviousPage) {
                html += `<a class="page-btn approval-page-link" href="#" data-page="1">First</a>`;
                html += `<a class="page-btn approval-page-link" href="#" data-page="${currentPage - 1}">Prev</a>`;
            } else {
                html += '<span class="page-btn disabled">First</span><span class="page-btn disabled">Prev</span>';
            }

            if (windowStart > 1) {
                html += `<a class="page-btn approval-page-link" href="#" data-page="1">1</a>`;
                if (windowStart > 2) {
                    html += '<span class="page-ellipsis">...</span>';
                }
            }

            for (let pageNumber = windowStart; pageNumber <= windowEnd; pageNumber++) {
                const activeClass = pageNumber === currentPage ? ' active' : '';
                html += `<a class="page-btn approval-page-link${activeClass}" href="#" data-page="${pageNumber}">${pageNumber}</a>`;
            }

            if (windowEnd < totalPages) {
                if (windowEnd < totalPages - 1) {
                    html += '<span class="page-ellipsis">...</span>';
                }
                html += `<a class="page-btn approval-page-link" href="#" data-page="${totalPages}">${totalPages}</a>`;
            }

            if (meta.hasNextPage) {
                html += `<a class="page-btn approval-page-link" href="#" data-page="${currentPage + 1}">Next</a>`;
                html += `<a class="page-btn approval-page-link" href="#" data-page="${totalPages}">Last</a>`;
            } else {
                html += '<span class="page-btn disabled">Next</span><span class="page-btn disabled">Last</span>';
            }

            html += '</nav>';
            paginationEl.innerHTML = html;
        }

        function renderApprovalPage(listPayload) {
            if (!listPayload) return;

            currentPageIndex = listPayload.pageIndex;
            currentPageSize = listPayload.pageSize;

            const taskListEl = document.getElementById('approval-task-list');
            const emptyStateEl = document.getElementById('approval-empty-state');

            if (listPayload.items.length === 0) {
                if (taskListEl) taskListEl.innerHTML = '';
                if (emptyStateEl) emptyStateEl.style.display = '';
            } else {
                if (taskListEl) {
                    taskListEl.innerHTML = listPayload.items
                        .map(task => renderTaskCard(task, listPayload.pageIndex, listPayload.pageSize))
                        .join('');
                }
                if (emptyStateEl) emptyStateEl.style.display = 'none';
            }

            if (typeof initProjectTruncation === 'function') {
                initProjectTruncation();
            }

            renderResultsHeader(listPayload);
            renderPagination(listPayload);
            clearSelection();
        }

        function clearSelection() {
            selectedLogIds.clear();
            document.querySelectorAll('.task-select').forEach(cb => { cb.checked = false; });
            syncSelectAllButton();
            updateBulkBar();
        }

        function syncSelectAllButton() {
            const btn = document.getElementById('bulkSelectAll');
            if (!btn) return;
            const allCheckboxes = document.querySelectorAll('.task-select');
            const allChecked = allCheckboxes.length > 0 && Array.from(allCheckboxes).every(cb => cb.checked);
            btn.querySelector('span').textContent = allChecked ? 'Deselect All' : 'Select All';
        }

        function updateBulkBar() {
            const countEl = document.getElementById('bulkCount');
            const approveBtn = document.getElementById('bulkApproveBtn');
            const rejectBtn = document.getElementById('bulkRejectBtn');
            const count = selectedLogIds.size;

            if (countEl) countEl.textContent = `${count} selected`;
            if (approveBtn) approveBtn.disabled = count === 0 || isRequestInFlight;
            if (rejectBtn) rejectBtn.disabled = count === 0 || isRequestInFlight;

            const toolbar = document.getElementById('bulkToolbar');
            if (toolbar) toolbar.style.display = '';
        }

        function getSelectedApprovePayload() {
            return Array.from(selectedLogIds).map(logId => {
                const card = document.querySelector(`.ts-task-card[data-log-id="${logId}"]`);
                const hoursInput = card?.querySelector('.edit-hours');
                const hours = parseFloat(hoursInput?.value ?? '0');
                return { logId: Number(logId), hours: Number.isFinite(hours) ? hours : 0 };
            });
        }

        function openBulkConfirm(action) {
            const modalTitle = document.getElementById('bulkModalTitle');
            const modalBody = document.getElementById('bulkModalBody');
            const confirmBtn = document.getElementById('bulkModalConfirm');
            const count = selectedLogIds.size;
            if (!modalTitle || !modalBody || !confirmBtn || count === 0) return;

            pendingBulkAction = action;
            confirmBtn.disabled = false;
            confirmBtn.querySelector('.confirm-text').style.display = '';
            confirmBtn.querySelector('.confirm-spinner').style.display = 'none';

            if (action === 'approve') {
                modalTitle.innerHTML = '<i class="fas fa-check me-2" style="color:var(--ts-accent);"></i>Confirm Bulk Approval';
                modalBody.innerHTML = `
                    <p style="margin-bottom:16px; color:var(--ts-text-muted);">
                        By selecting Approve, you confirm that you have reviewed and validated all selected tasks and submitted hours.
                        You acknowledge that this approval is based on your verification as the employee's manager and that you are fully aware and responsible for the approved timesheet entries.
                    </p>
                    <p style="margin-bottom:0; font-weight:600; color:var(--ts-primary);">${count} task(s) will be approved.</p>`;
                confirmBtn.className = 'btn btn-success';
                confirmBtn.querySelector('.confirm-text').textContent = 'Approve';
            } else {
                modalTitle.innerHTML = '<i class="fas fa-times me-2" style="color:#dc2626;"></i>Confirm Bulk Rejection';
                modalBody.innerHTML = `
                    <p style="margin-bottom:16px; color:var(--ts-text-muted);">
                        Reject ${count} selected task(s)? Rejected tasks will be returned to employees for revision.
                    </p>`;
                confirmBtn.className = 'btn btn-danger';
                confirmBtn.querySelector('.confirm-text').textContent = 'Reject';
            }

            if (!bulkModal) {
                bulkModal = new bootstrap.Modal(document.getElementById('bulkConfirmModal'));
            }
            bulkModal.show();
        }

        function formatBulkMessage(response) {
            let text = response.message || '';
            if (response.bulk?.failures?.length > 0) {
                const reasons = response.bulk.failures.map(f => `Task #${f.logId}: ${f.reason}`).join('\n');
                text += '\n\n' + reasons;
            }
            return text;
        }

        async function performBulkApprove() {
            if (isRequestInFlight || selectedLogIds.size === 0) return;

            const payload = {
                pageIndex: currentPageIndex,
                pageSize: currentPageSize,
                tasks: getSelectedApprovePayload()
            };

            await performBulkPost('BulkApprove', payload, 'alert alert-success');
        }

        async function performBulkReject() {
            if (isRequestInFlight || selectedLogIds.size === 0) return;

            const payload = {
                pageIndex: currentPageIndex,
                pageSize: currentPageSize,
                logIds: Array.from(selectedLogIds).map(Number)
            };

            await performBulkPost('BulkReject', payload, 'alert alert-warning');
        }

        async function performBulkPost(handler, payload, successClass) {
            isRequestInFlight = true;
            updateBulkBar();
            const confirmBtn = document.getElementById('bulkModalConfirm');
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.querySelector('.confirm-text').style.display = 'none';
                confirmBtn.querySelector('.confirm-spinner').style.display = '';
            }

            try {
                const response = await fetch(`?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json().catch(() => null);
                if (!response.ok || !data?.success) {
                    showMessage(data?.message || 'Bulk action failed. Please try again.', data?.messageClass || 'alert alert-danger');
                    return;
                }

                const message = formatBulkMessage(data);
                showMessage(message, data.messageClass || successClass);

                if (data.list) {
                    renderApprovalPage(data.list);
                }
            } finally {
                isRequestInFlight = false;
                updateBulkBar();
                if (bulkModal) bulkModal.hide();
                if (confirmBtn) {
                    confirmBtn.disabled = false;
                    confirmBtn.querySelector('.confirm-text').style.display = '';
                    confirmBtn.querySelector('.confirm-spinner').style.display = 'none';
                }
            }
        }

        async function readJsonOrShowError(response, fallbackMessage) {
            const data = await response.json().catch(() => null);
            if (!response.ok) {
                showMessage(
                    data?.message ?? fallbackMessage,
                    data?.messageClass ?? 'alert alert-danger'
                );
                return null;
            }

            return data;
        }

        async function fetchPendingTasks(pageIndex, pageSize) {
            const params = new URLSearchParams({
                handler: 'PendingTasks',
                'Criteria.PageIndex': pageIndex,
                'Criteria.PageSize': pageSize
            });

            const response = await fetch(`?${params}`);
            return readJsonOrShowError(response, 'Unable to load pending tasks. Please try again.');
        }

        async function postAction(handler, { id, hours, pageIndex, pageSize }) {
            const body = new URLSearchParams({
                id,
                'Criteria.PageIndex': pageIndex,
                'Criteria.PageSize': pageSize
            });

            if (hours != null && hours !== '') {
                body.set('hours', hours);
            }

            const response = await fetch(`?handler=${handler}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body
            });

            return readJsonOrShowError(response, 'Action failed. Please try again.');
        }

        async function refreshList(pageIndex, pageSize) {
            isRequestInFlight = true;
            try {
                const response = await fetchPendingTasks(pageIndex, pageSize);
                if (!response) {
                    return;
                }

                if (!response.success) {
                    showMessage(response.message || 'Unable to load pending tasks.', response.messageClass || 'alert alert-danger');
                    return;
                }

                renderApprovalPage(response.list);
            } finally {
                isRequestInFlight = false;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const taskListEl = document.getElementById('approval-task-list');
            const paginationEl = document.getElementById('approval-pagination');
            const resultsHeaderEl = document.getElementById('approval-results-header');

            taskListEl?.addEventListener('click', async (event) => {
                const button = event.target.closest('[data-action]');
                if (!button || isRequestInFlight) return;

                const cardEl = button.closest('.ts-task-card');
                const logId = cardEl?.dataset.logId;
                const action = button.dataset.action;
                if (!logId || !action) return;

                const hoursInput = cardEl.querySelector('.edit-hours');
                const hours = hoursInput?.value ?? '';

                setLoading(cardEl, true);
                isRequestInFlight = true;

                try {
                    const handler = action === 'approve' ? 'Approve' : 'Reject';
                    const response = await postAction(handler, {
                        id: logId,
                        hours: action === 'approve' ? hours : null,
                        pageIndex: currentPageIndex,
                        pageSize: currentPageSize
                    });

                    if (!response) {
                        setLoading(cardEl, false);
                        return;
                    }

                    if (response.success) {
                        if (response.message) {
                            showMessage(response.message, response.messageClass || 'alert alert-success');
                        }
                        if (response.list) {
                            renderApprovalPage(response.list);
                        }
                    } else {
                        showMessage(response.message || 'Action failed.', response.messageClass || 'alert alert-danger');
                        setLoading(cardEl, false);
                    }
                } finally {
                    isRequestInFlight = false;
                }
            });

            paginationEl?.addEventListener('click', async (event) => {
                const link = event.target.closest('.approval-page-link');
                if (!link || isRequestInFlight) return;

                event.preventDefault();
                const targetPage = Number(link.dataset.page);
                if (!targetPage || targetPage === currentPageIndex) return;

                await refreshList(targetPage, currentPageSize);
            });

            resultsHeaderEl?.addEventListener('change', async (event) => {
                const select = event.target.closest('#approvalPageSize');
                if (!select || isRequestInFlight) return;

                const newSize = Number(select.value);
                if (!newSize || newSize === currentPageSize) return;

                currentPageSize = newSize;
                await refreshList(1, newSize);
            });

            resultsHeaderEl?.addEventListener('click', (event) => {
                const selectAllBtn = event.target.closest('#bulkSelectAll');
                if (selectAllBtn) {
                    const checkboxes = document.querySelectorAll('.task-select');
                    const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                    const shouldCheck = !allChecked;
                    checkboxes.forEach(cb => {
                        cb.checked = shouldCheck;
                        const logId = Number(cb.dataset.logId);
                        if (shouldCheck) selectedLogIds.add(logId);
                        else selectedLogIds.delete(logId);
                    });
                    syncSelectAllButton();
                    updateBulkBar();
                    return;
                }

                const approveBtn = event.target.closest('#bulkApproveBtn');
                if (approveBtn && !approveBtn.disabled && selectedLogIds.size > 0) {
                    openBulkConfirm('approve');
                    return;
                }

                const rejectBtn = event.target.closest('#bulkRejectBtn');
                if (rejectBtn && !rejectBtn.disabled && selectedLogIds.size > 0) {
                    openBulkConfirm('reject');
                }
            });

            taskListEl?.addEventListener('change', (event) => {
                const checkbox = event.target.closest('.task-select');
                if (!checkbox) return;

                const logId = Number(checkbox.dataset.logId);
                if (checkbox.checked) selectedLogIds.add(logId);
                else selectedLogIds.delete(logId);

                syncSelectAllButton();
                updateBulkBar();
            });

            document.getElementById('bulkModalConfirm')?.addEventListener('click', () => {
                if (isRequestInFlight) return;

                if (pendingBulkAction === 'approve') {
                    performBulkApprove();
                } else if (pendingBulkAction === 'reject') {
                    performBulkReject();
                }
            });

            document.getElementById('approval-message-close')?.addEventListener('click', () => {
                const messageEl = document.getElementById('approval-message');
                messageEl?.classList.remove('is-visible');
            });

            syncSelectAllButton();
            updateBulkBar();
        });
    </script>

</body>
</html>

