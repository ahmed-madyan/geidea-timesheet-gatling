                const pnl = document.getElementById('pnlProjContext');
                if (!val) { pnl.style.display = 'none'; triggerValidate(); return; }
                fetch(`?handler=ProjectDetails&projectId=${encodeURIComponent(val)}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data && data[0]) {
                            document.getElementById('litProjCountry').innerText  = data[0].country    || '-';
                            document.getElementById('litProjCategory').innerText = data[0].category   || '-';
                            document.getElementById('litProjDept').innerText     = data[0].department || '-';
                            pnl.style.display = 'grid';
                        } else {
                            pnl.style.display = 'none';
                        }
                    })
                    .catch(() => pnl.style.display = 'none')
                    .finally(() => triggerValidate());
            }
        });

        // expose so filter IIFE can call it
        function triggerValidate() {
            document.getElementById('ddlProject').dispatchEvent(new Event('change'));
        }

        // placeholder — real handler is TomSelect onChange above
        document.getElementById('ddlProject').addEventListener('change', function() {
            const val = this.value;
            const pnl = document.getElementById('pnlProjContext');

            if (!val) {
                pnl.style.display = 'none';
                return;
            }

        // handled by TomSelect onChange
        });

        (function () {
        const form = document.querySelector('form');
        const btn = document.getElementById('btnSubmit');

        const requiredIds = [
            'ddlProject', // TomSelect updates the underlying <select> value
            'Input_TaskName',
            'Input_Description',
            'Input_TaskDate',
            'Input_Hours'
        ];

        function validate() {
            const allFilled = requiredIds.every(id => {
                const el = document.getElementById(id);
                return el && el.value.trim() !== '' && el.value !== '0';
            });
            btn.disabled = !allFilled;
        }

        requiredIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', validate);
        });

        validate(); // run once on load



        btn.addEventListener('click', function() {
            setTimeout(() => {
                btn.disabled = true; // prevent multiple submits
            }, 100);
        });

    })();


    (function () {
    const ddlDept    = document.getElementById('ddlDepartment');
    const ddlCountry = document.getElementById('ddlCountry');
    const ddlProject = document.getElementById('ddlProject');
    const spinner    = document.getElementById('projLoadSpinner');
    const badge      = document.getElementById('filterBadge');
    const badgeText  = document.getElementById('filterBadgeText');
    const clearBtn   = document.getElementById('clearFilters');
    const pnl        = document.getElementById('pnlProjContext');

    // Initialize TomSelect with server-provided projects on page load
    const initialProjects = Array.from(ddlProject.options)
        .filter(opt => opt.value !== '')
        .map(opt => ({ value: opt.value, text: opt.text }));

    if (initialProjects.length > 0) {
        projectSelect.addOptions(initialProjects);
    }

    function updateBadge() {
        const parts = [];
        if (ddlDept.value)    parts.push(ddlDept.options[ddlDept.selectedIndex].text);
        if (ddlCountry.value) parts.push(ddlCountry.options[ddlCountry.selectedIndex].text);
        if (parts.length) {
            badgeText.textContent = 'Filtered by: ' + parts.join(' · ');
            badge.style.display = 'block';
        } else {
            badge.style.display = 'none';
        }
    }

    function rebuildProjectDropdown(projects) {
        const currentVal = projectSelect.getValue();
        projectSelect.clearOptions();
        projectSelect.addOptions(projects.map(p => ({ value: p.value, text: p.text })));

        const stillValid = projects.some(p => p.value === currentVal);
        if (stillValid) {
            projectSelect.setValue(currentVal, true);
        } else {
            projectSelect.clear(true);
            pnl.style.display = 'none';
        }

        document.getElementById('ddlProject').dispatchEvent(new Event('change'));
    }

    function fetchFilteredProjects() {
        const deptId    = ddlDept.value;
        const countryId = ddlCountry.value;

        spinner.style.display = 'inline';

        fetch(`?handler=FilteredProjects&departmentId=${encodeURIComponent(deptId)}&countryId=${encodeURIComponent(countryId)}`)
            .then(r => r.json())
            .then(projects => {
                rebuildProjectDropdown(projects);
                updateBadge();
            })
            .catch(err => console.error('Filter error:', err))
            .finally(() => spinner.style.display = 'none');
    }

    ddlDept.addEventListener('change', fetchFilteredProjects);
    ddlCountry.addEventListener('change', fetchFilteredProjects);

    clearBtn?.addEventListener('click', function (e) {
        e.preventDefault();
        ddlDept.value = '';
        ddlCountry.value = '';
        fetchFilteredProjects();
    });
})();

    // Delete modal
    function showDeleteModal(logId, taskName, projectName) {
        document.getElementById('deleteLogId').value = logId;
        document.getElementById('deleteTaskName').textContent = taskName;
        document.getElementById('deleteProjectName').textContent = projectName;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
    </script>

</body>
</html>

