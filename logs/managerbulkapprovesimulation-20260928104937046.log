    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    // Adapter for [DateGreaterThanOrEqualTo] — current date input must be >= the referenced date input.
    // Emits data-val-dategreaterthanequalto and data-val-dategreaterthanequalto-other on the client.
    (function ($) {
        if (!$.validator || !$.validator.unobtrusive) return;

        $.validator.addMethod("dategreaterthanequalto", function (value, element, params) {
            if (!value) return true; // let [Required] handle empty values
            var $other = $(element).closest("form").find('input[name="' + params.otherName + '"]');
            if ($other.length === 0) return true;
            var otherValue = $other.val();
            if (!otherValue) return true; // let [Required] on the other field handle empty values

            var current = new Date(value);
            var other = new Date(otherValue);
            if (isNaN(current.getTime()) || isNaN(other.getTime())) return true;

            return current.getTime() >= other.getTime();
        });

        $.validator.unobtrusive.adapters.add("dategreaterthanequalto", ["other"], function (options) {
            // Derive the other input's name from the validated element's name by swapping
            // the last path segment, e.g. "Query.Filter.EndDate" -> "Query.Filter.StartDate",
            // "Input.EndDate" -> "Input.StartDate". This is independent of element ids (which
            // may be overridden) and is scoped to the same form to avoid matching hidden
            // round-trip inputs in other forms on the same page.
            var elementName = options.element.name;
            var lastDot = elementName.lastIndexOf(".");
            var otherName = lastDot >= 0
                ? elementName.substring(0, lastDot + 1) + options.params.other
                : options.params.other;

            options.rules["dategreaterthanequalto"] = { otherName: otherName };
            if (options.message) {
                options.messages["dategreaterthanequalto"] = options.message;
            }

            // Re-run this field's validation when the referenced field changes,
            // so the comparison error stays accurate as the user edits either date.
            var $form = $(options.element).closest("form");
            $form.find('input[name="' + otherName + '"]').on("change input", function () {
                var validator = $form.data("validator");
                if (validator) validator.element(options.element);
            });
        });
    })(jQuery);

    $(document).ready(function () {
        $("form").validate({
            rules: {
                "Input.ProjectName": {
                    required: true,
                    maxlength: 200
                },
                "Input.ProjectDetails": {
                    required: true,
                    maxlength: 16384
                }
            },
            messages: {
                "Input.ProjectName": {
                    maxlength: "Project Name cannot exceed 200 characters."
                },
                "Input.ProjectDetails": {
                    maxlength: "Project Details cannot exceed 16,384 characters."
                }
            },
            errorElement: 'span',
            errorClass: 'text-danger small',
            highlight: function (element) {
                $(element).addClass('input-validation-error');
            },
            unhighlight: function (element) {
                $(element).removeClass('input-validation-error');
            }
        });
    });
</script>

