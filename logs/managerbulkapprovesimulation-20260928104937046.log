    <script>
        // Live clock
        function updateDateTime() {
            const now = new Date();
            const el = document.getElementById('live-clock');
            if (el) {
                el.innerText = now.toLocaleDateString('en-GB', {
                    weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
                }) + '  •  ' + now.toLocaleTimeString();
            }
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>

    <script>
        function initProjectTruncation() {
            document.querySelectorAll('.ts-project-name-truncate').forEach(function (el) {
                if (el.dataset.initialized) return;
                el.dataset.initialized = 'true';

                // Check if the element overflows horizontally
                if (el.scrollWidth > el.offsetWidth) {
                    var toggle = document.createElement('a');
                    toggle.href = '#';
                    toggle.className = 'toggle-text-btn ms-1';
                    toggle.textContent = 'More';

                    toggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        if (el.classList.contains('expanded')) {
                            el.classList.remove('expanded');
                            toggle.textContent = 'More';
                        } else {
                            el.classList.add('expanded');
                            toggle.textContent = 'Less';
                        }
                    });

                    el.after(toggle);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Tiny timeout to ensure client layout computations have completed
            setTimeout(initProjectTruncation, 50);
        });
    </script>

    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css">
